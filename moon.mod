name = "xinorigin/moon_warc"

version = "0.2.0"

readme = "README.md"

repository = "https://github.com/XinOrigin/moon-warc"

license = "Apache-2.0"

keywords = [ "warc", "iso28500", "cdxj", "surt", "web-archive" ]

description = "Pure-MoonBit ISO 28500 WARC 1.0/1.1 streaming codec, SHA-1/SHA-256 verifier, SURT/CDXJ/CDX-11 indexer, ISO 28500 §9 segmentation, subset filter, JSONL exporter, and conformance validator."
