name = "XinOrigin/moon_warc"

version = "0.5.0"

supported_targets = [ "wasm", "wasm-gc", "js", "native" ]

readme = "README.mbt.md"

repository = "https://github.com/XinOrigin/moon-warc"

license = "Apache-2.0"

keywords = [
  "warc",
  "warc-gz",
  "wacz",
  "iso28500",
  "cdxj",
  "surt",
  "web-archive",
]

description = "Pure-MoonBit ISO 28500 WARC 1.0/1.1 & multi-member Dynamic-Huffman .warc.gz streaming codec, WACZ 1.1.1 manifest builder, SHA-1/SHA-256 verifier, SURT/CDXJ/CDX-11 indexer, §9 segmentation, JSONL exporter, and conformance validator."
